    conv2d_10 = CONV_2D(depthwise_conv2d_9, conv2d_10/Kernel_dequantize, conv2d_10/Bias_dequantize, padding="VALID", stride_w=1, stride_h=1, dilation_w_factor=1, dilation_h_factor=1, fused_activation="NONE");
    # PAD (tflite)
    channel_padding_8 = PAD(activation_9, channel_padding_8/Paddings);
    # ADD (tflite)
    add_9__xeno_compat__1 = ADD(channel_padding_8, conv2d_10, fused_activation="NONE");
    # RELU (tflite)
    activation_10 = RELU(add_9__xeno_compat__1);
    # DEQUANTIZE (tflite)
    depthwise_conv2d_10/Bias_dequantize = DEQUANTIZE(depthwise_conv2d_10/Bias);
    # DEQUANTIZE (tflite)
    depthwise_conv2d_10/Kernel_dequantize = DEQUANTIZE(depthwise_conv2d_10/Kernel);
    # DEPTHWISE_CONV_2D (tflite)
    depthwise_conv2d_10 = DEPTHWISE_CONV_2D(activation_10, depthwise_conv2d_10/Kernel_dequantize, depthwise_conv2d_10/Bias_dequantize, padding="SAME", stride_w=1, stride_h=1, depth_multiplier=1, dilation_w_factor=1, dilation_h_factor=1, fused_activation="NONE");
    # DEQUANTIZE (tflite)
    conv2d_11/Bias_dequantize = DEQUANTIZE(conv2d_11/Bias);
    # DEQUANTIZE (tflite)
    conv2d_11/Kernel_dequantize = DEQUANTIZE(conv2d_11/Kernel);
    # CONV_2D (tflite)
    conv2d_11 = CONV_2D(depthwise_conv2d_10, conv2d_11/Kernel_dequantize, conv2d_11/Bias_dequantize, padding="VALID", stride_w=1, stride_h=1, dilation_w_factor=1, dilation_h_factor=1, fused_activation="NONE");
    # PAD (tflite)
    channel_padding_9 = PAD(activation_10, channel_padding_9/Paddings);
    # ADD (tflite)
    add_10__xeno_compat__1 = ADD(channel_padding_9, conv2d_11, fused_activation="NONE");
    # RELU (tflite)
    activation_11 = RELU(add_10__xeno_compat__1);
    # DEQUANTIZE (tflite)
    depthwise_conv2d_11/Bias_dequantize = DEQUANTIZE(depthwise_conv2d_11/Bias);
    # DEQUANTIZE (tflite)
    depthwise_conv2d_11/Kernel_dequantize = DEQUANTIZE(depthwise_conv2d_11/Kernel);
    # DEPTHWISE_CONV_2D (tflite)
    depthwise_conv2d_11 = DEPTHWISE_CONV_2D(activation_11, depthwise_conv2d_11/Kernel_dequantize, depthwise_conv2d_11/Bias_dequantize, padding="SAME", stride_w=2, stride_h=2, depth_multiplier=1, dilation_w_factor=1, dilation_h_factor=1, fused_activation="NONE");
    # MAX_POOL_2D (tflite)
    max_pooling2d_2 = MAX_POOL_2D(activation_11, padding="SAME", stride_w=2, stride_h=2, filter_width=2, filter_height=2, fused_activation="NONE");
    # DEQUANTIZE (tflite)
    conv2d_12/Bias_dequantize = DEQUANTIZE(conv2d_12/Bias);
    # DEQUANTIZE (tflite)
    conv2d_12/Kernel_dequantize = DEQUANTIZE(conv2d_12/Kernel);
    # CONV_2D (tflite)
    conv2d_12 = CONV_2D(depthwise_conv2d_11, conv2d_12/Kernel_dequantize, conv2d_12/Bias_dequantize, padding="VALID", stride_w=1, stride_h=1, dilation_w_factor=1, dilation_h_factor=1, fused_activation="NONE");
    # PAD (tflite)
    channel_padding_10 = PAD(max_pooling2d_2, channel_padding_10/Paddings);
    # ADD (tflite)
    add_11__xeno_compat__1 = ADD(channel_padding_10, conv2d_12, fused_activation="NONE");
    # RELU (tflite)
    activation_12 = RELU(add_11__xeno_compat__1);
    # DEQUANTIZE (tflite)
    depthwise_conv2d_12/Bias_dequantize = DEQUANTIZE(depthwise_conv2d_12/Bias);
    # DEQUANTIZE (tflite)
    depthwise_conv2d_12/Kernel_dequantize = DEQUANTIZE(depthwise_conv2d_12/Kernel);
    # DEPTHWISE_CONV_2D (tflite)
    depthwise_conv2d_12 = DEPTHWISE_CONV_2D(activation_12, depthwise_conv2d_12/Kernel_dequantize, depthwise_conv2d_12/Bias_dequantize, padding="SAME", stride_w=1, stride_h=1, depth_multiplier=1, dilation_w_factor=1, dilation_h_factor=1, fused_activation="NONE");
    # DEQUANTIZE (tflite)
    conv2d_13/Bias_dequantize = DEQUANTIZE(conv2d_13/Bias);
    # DEQUANTIZE (tflite)
    conv2d_13/Kernel_dequantize = DEQUANTIZE(conv2d_13/Kernel);
    # CONV_2D (tflite)
    conv2d_13 = CONV_2D(depthwise_conv2d_12, conv2d_13/Kernel_dequantize, conv2d_13/Bias_dequantize, padding="VALID", stride_w=1, stride_h=1, dilation_w_factor=1, dilation_h_factor=1, fused_activation="NONE");
    # ADD (tflite)
    add_12__xeno_compat__1 = ADD(activation_12, conv2d_13, fused_activation="NONE");
    # RELU (tflite)
    activation_13 = RELU(add_12__xeno_compat__1);
    # DEQUANTIZE (tflite)
    depthwise_conv2d_13/Bias_dequantize = DEQUANTIZE(depthwise_conv2d_13/Bias);
    # DEQUANTIZE (tflite)
    depthwise_conv2d_13/Kernel_dequantize = DEQUANTIZE(depthwise_conv2d_13/Kernel);
    # DEPTHWISE_CONV_2D (tflite)
    depthwise_conv2d_13 = DEPTHWISE_CONV_2D(activation_13, depthwise_conv2d_13/Kernel_dequantize, depthwise_conv2d_13/Bias_dequantize, padding="SAME", stride_w=1, stride_h=1, depth_multiplier=1, dilation_w_factor=1, dilation_h_factor=1, fused_activation="NONE");
    # DEQUANTIZE (tflite)
    conv2d_14/Bias_dequantize = DEQUANTIZE(conv2d_14/Bias);
    # DEQUANTIZE (tflite)
    conv2d_14/Kernel_dequantize = DEQUANTIZE(conv2d_14/Kernel);
    # CONV_2D (tflite)
    conv2d_14 = CONV_2D(depthwise_conv2d_13, conv2d_14/Kernel_dequantize, conv2d_14/Bias_dequantize, padding="VALID", stride_w=1, stride_h=1, dilation_w_factor=1, dilation_h_factor=1, fused_activation="NONE");
    # ADD (tflite)
    add_13__xeno_compat__1 = ADD(activation_13, conv2d_14, fused_activation="NONE");
    # RELU (tflite)
    activation_14 = RELU(add_13__xeno_compat__1);
    # DEQUANTIZE (tflite)
    depthwise_conv2d_14/Bias_dequantize = DEQUANTIZE(depthwise_conv2d_14/Bias);
    # DEQUANTIZE (tflite)
    depthwise_conv2d_14/Kernel_dequantize = DEQUANTIZE(depthwise_conv2d_14/Kernel);
    # DEPTHWISE_CONV_2D (tflite)
    depthwise_conv2d_14 = DEPTHWISE_CONV_2D(activation_14, depthwise_conv2d_14/Kernel_dequantize, depthwise_conv2d_14/Bias_dequantize, padding="SAME", stride_w=1, stride_h=1, depth_multiplier=1, dilation_w_factor=1, dilation_h_factor=1, fused_activation="NONE");
    # DEQUANTIZE (tflite)
    conv2d_15/Bias_dequantize = DEQUANTIZE(conv2d_15/Bias);
    # DEQUANTIZE (tflite)
    conv2d_15/Kernel_dequantize = DEQUANTIZE(conv2d_15/Kernel);
    # CONV_2D (tflite)
    conv2d_15 = CONV_2D(depthwise_conv2d_14, conv2d_15/Kernel_dequantize, conv2d_15/Bias_dequantize, padding="VALID", stride_w=1, stride_h=1, dilation_w_factor=1, dilation_h_factor=1, fused_activation="NONE");
    # ADD (tflite)
    add_14__xeno_compat__1 = ADD(activation_14, conv2d_15, fused_activation="NONE");
    # RELU (tflite)
    activation_15 = RELU(add_14__xeno_compat__1);
    # DEQUANTIZE (tflite)
    depthwise_conv2d_15/Kernel_dequantize = DEQUANTIZE(depthwise_conv2d_15/Kernel);
    # DEQUANTIZE (tflite)
    depthwise_conv2d_15/Bias_dequantize = DEQUANTIZE(depthwise_conv2d_15/Bias);
    # DEPTHWISE_CONV_2D (tflite)
    depthwise_conv2d_15 = DEPTHWISE_CONV_2D(activation_15, depthwise_conv2d_15/Kernel_dequantize, depthwise_conv2d_15/Bias_dequantize, padding="SAME", stride_w=1, stride_h=1, depth_multiplier=1, dilation_w_factor=1, dilation_h_factor=1, fused_activation="NONE");
    # DEQUANTIZE (tflite)
    conv2d_16/Bias_dequantize = DEQUANTIZE(conv2d_16/Bias);
    # DEQUANTIZE (tflite)
    conv2d_16/Kernel_dequantize = DEQUANTIZE(conv2d_16/Kernel);
    # CONV_2D (tflite)
    conv2d_16 = CONV_2D(depthwise_conv2d_15, conv2d_16/Kernel_dequantize, conv2d_16/Bias_dequantize, padding="VALID", stride_w=1, stride_h=1, dilation_w_factor=1, dilation_h_factor=1, fused_activation="NONE");
    # ADD (tflite)
    add_15__xeno_compat__1 = ADD(activation_15, conv2d_16, fused_activation="NONE");
    # RELU (tflite)
    activation_16 = RELU(add_15__xeno_compat__1);
    # DEQUANTIZE (tflite)
    classificator_8/Bias_dequantize = DEQUANTIZE(classificator_8/Bias);
    # DEQUANTIZE (tflite)
    classificator_8/Kernel_dequantize = DEQUANTIZE(classificator_8/Kernel);
    # CONV_2D (tflite)
    classificator_8 = CONV_2D(activation_11, classificator_8/Kernel_dequantize, classificator_8/Bias_dequantize, padding="SAME", stride_w=1, stride_h=1, dilation_w_factor=1, dilation_h_factor=1, fused_activation="NONE");
    # DEQUANTIZE (tflite)
    classificator_16/Kernel_dequantize = DEQUANTIZE(classificator_16/Kernel);
    # DEQUANTIZE (tflite)
    classificator_16/Bias_dequantize = DEQUANTIZE(classificator_16/Bias);
    # CONV_2D (tflite)
    classificator_16 = CONV_2D(activation_16, classificator_16/Kernel_dequantize, classificator_16/Bias_dequantize, padding="SAME", stride_w=1, stride_h=1, dilation_w_factor=1, dilation_h_factor=1, fused_activation="NONE");
    # DEQUANTIZE (tflite)
    regressor_8/Kernel_dequantize = DEQUANTIZE(regressor_8/Kernel);
    # DEQUANTIZE (tflite)
    regressor_8/Bias_dequantize = DEQUANTIZE(regressor_8/Bias);
    # CONV_2D (tflite)
    regressor_8 = CONV_2D(activation_11, regressor_8/Kernel_dequantize, regressor_8/Bias_dequantize, padding="SAME", stride_w=1, stride_h=1, dilation_w_factor=1, dilation_h_factor=1, fused_activation="NONE");
    # DEQUANTIZE (tflite)
    regressor_16/Bias_dequantize = DEQUANTIZE(regressor_16/Bias);
    # DEQUANTIZE (tflite)
    regressor_16/Kernel_dequantize = DEQUANTIZE(regressor_16/Kernel);
    # CONV_2D (tflite)
    regressor_16 = CONV_2D(activation_16, regressor_16/Kernel_dequantize, regressor_16/Bias_dequantize, padding="SAME", stride_w=1, stride_h=1, dilation_w_factor=1, dilation_h_factor=1, fused_activation="NONE");
    # RESHAPE (tflite)
    reshape = RESHAPE(classificator_8, new_shape=[1, -1, 1]);
    # RESHAPE (tflite)
    reshape_2 = RESHAPE(classificator_16, new_shape=[1, -1, 1]);
    # RESHAPE (tflite)
    reshape_1 = RESHAPE(regressor_8, new_shape=[1, -1, 16]);
    # RESHAPE (tflite)
    reshape_3 = RESHAPE(regressor_16, new_shape=[1, -1, 16]);
    # CONCATENATION (tflite)
    classificators = CONCATENATION(reshape, reshape_2, axis=1, fused_activation="NONE");
    # CONCATENATION (tflite)
    regressors = CONCATENATION(reshape_1, reshape_3, axis=1, fused_activation="NONE");
  }

  outputs { regressors, classificators; }
}
