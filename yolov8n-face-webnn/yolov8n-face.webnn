    # Conv (onnx)
    conv2d_11 = Conv(silu_10, model.4.m.1.cv2.conv.weight, model.4.m.1.cv2.conv.bias, group=1, auto_pad="NOTSET", dilations=[1, 1], strides=[1, 1], pads=[1, 1, 1, 1]);
    # Sigmoid (onnx)
    val_15 = Sigmoid(conv2d_11);
    # Mul (onnx)
    silu_11 = Mul(conv2d_11, val_15);
    # Add (onnx)
    add_2 = Add(add_1, silu_11);
    # Concat (onnx)
    cat_1 = Concat(split_with_sizes_4_split_0, split_with_sizes_4_split_1, add_1, add_2, axis=1);
    # Conv (onnx)
    conv2d_12 = Conv(cat_1, model.4.cv2.conv.weight, model.4.cv2.conv.bias, group=1, auto_pad="NOTSET", dilations=[1, 1], strides=[1, 1], pads=[0, 0, 0, 0]);
    # Sigmoid (onnx)
    val_16 = Sigmoid(conv2d_12);
    # Mul (onnx)
    silu_12 = Mul(conv2d_12, val_16);
    # Conv (onnx)
