    # Conv (onnx)
    conv2d_62 = Conv(silu_56, model.22.cv3.2.2.weight, model.22.cv3.2.2.bias, group=1, auto_pad="NOTSET", dilations=[1, 1], strides=[1, 1], pads=[0, 0, 0, 0]);
    # Conv (onnx)
    conv2d_63 = Conv(silu_34, model.22.cv4.0.0.conv.weight, model.22.cv4.0.0.conv.bias, group=1, auto_pad="NOTSET", dilations=[1, 1], strides=[1, 1], pads=[1, 1, 1, 1]);
    # Sigmoid (onnx)
    val_74 = Sigmoid(conv2d_63);
    # Mul (onnx)
    silu_57 = Mul(conv2d_63, val_74);
    # Conv (onnx)
    conv2d_64 = Conv(silu_57, model.22.cv4.0.1.conv.weight, model.22.cv4.0.1.conv.bias, group=1, auto_pad="NOTSET", dilations=[1, 1], strides=[1, 1], pads=[1, 1, 1, 1]);
    # Sigmoid (onnx)
    val_75 = Sigmoid(conv2d_64);
    # Mul (onnx)
    silu_58 = Mul(conv2d_64, val_75);
    # Conv (onnx)
    conv2d_65 = Conv(silu_58, model.22.cv4.0.2.weight, model.22.cv4.0.2.bias, group=1, auto_pad="NOTSET", dilations=[1, 1], strides=[1, 1], pads=[0, 0, 0, 0]);
    # Concat (onnx)
    output0 = Concat(conv2d_47, conv2d_50, conv2d_65, axis=1);
    # Conv (onnx)
    conv2d_66 = Conv(silu_39, model.22.cv4.1.0.conv.weight, model.22.cv4.1.0.conv.bias, group=1, auto_pad="NOTSET", dilations=[1, 1], strides=[1, 1], pads=[1, 1, 1, 1]);
    # Sigmoid (onnx)
    val_76 = Sigmoid(conv2d_66);
    # Mul (onnx)
    silu_59 = Mul(conv2d_66, val_76);
    # Conv (onnx)
    conv2d_67 = Conv(silu_59, model.22.cv4.1.1.conv.weight, model.22.cv4.1.1.conv.bias, group=1, auto_pad="NOTSET", dilations=[1, 1], strides=[1, 1], pads=[1, 1, 1, 1]);
    # Sigmoid (onnx)
    val_77 = Sigmoid(conv2d_67);
    # Mul (onnx)
    silu_60 = Mul(conv2d_67, val_77);
    # Conv (onnx)
    conv2d_68 = Conv(silu_60, model.22.cv4.1.2.weight, model.22.cv4.1.2.bias, group=1, auto_pad="NOTSET", dilations=[1, 1], strides=[1, 1], pads=[0, 0, 0, 0]);
    # Concat (onnx)
    cat_17 = Concat(conv2d_53, conv2d_56, conv2d_68, axis=1);
    # Conv (onnx)
    conv2d_69 = Conv(silu_44, model.22.cv4.2.0.conv.weight, model.22.cv4.2.0.conv.bias, group=1, auto_pad="NOTSET", dilations=[1, 1], strides=[1, 1], pads=[1, 1, 1, 1]);
    # Sigmoid (onnx)
    val_78 = Sigmoid(conv2d_69);
    # Mul (onnx)
    silu_61 = Mul(conv2d_69, val_78);
    # Conv (onnx)
    conv2d_70 = Conv(silu_61, model.22.cv4.2.1.conv.weight, model.22.cv4.2.1.conv.bias, group=1, auto_pad="NOTSET", dilations=[1, 1], strides=[1, 1], pads=[1, 1, 1, 1]);
    # Sigmoid (onnx)
    val_79 = Sigmoid(conv2d_70);
    # Mul (onnx)
    silu_62 = Mul(conv2d_70, val_79);
    # Conv (onnx)
    conv2d_71 = Conv(silu_62, model.22.cv4.2.2.weight, model.22.cv4.2.2.bias, group=1, auto_pad="NOTSET", dilations=[1, 1], strides=[1, 1], pads=[0, 0, 0, 0]);
    # Concat (onnx)
    cat_18 = Concat(conv2d_59, conv2d_62, conv2d_71, axis=1);
  }

  outputs { output0, cat_17, cat_18; }
}
