    # Sigmoid (onnx)
    val_2 = Sigmoid(conv2d_2);
    # Mul (onnx)
    silu_2 = Mul(conv2d_2, val_2);
    # Split (onnx)
    [split_with_sizes_1_split_0, split_with_sizes_1_split_1] = Split(silu_2, val_3, axis=1);
    # Conv (onnx)
    conv2d_3 = Conv(split_with_sizes_1_split_1, model.2.m.0.cv1.conv.weight, model.2.m.0.cv1.conv.bias, group=1, auto_pad="NOTSET", dilations=[1, 1], strides=[1, 1], pads=[1, 1, 1, 1]);
    # Sigmoid (onnx)
