    # Mul (onnx)
    silu_7 = Mul(conv2d_7, val_10);
    # Split (onnx)
    [split_with_sizes_4_split_0, split_with_sizes_4_split_1] = Split(silu_7, val_11, axis=1);
    # Conv (onnx)
    conv2d_8 = Conv(split_with_sizes_4_split_1, model.4.m.0.cv1.conv.weight, model.4.m.0.cv1.conv.bias, group=1, auto_pad="NOTSET", dilations=[1, 1], strides=[1, 1], pads=[1, 1, 1, 1]);
    # Sigmoid (onnx)
    val_12 = Sigmoid(conv2d_8);
    # Mul (onnx)
    silu_8 = Mul(conv2d_8, val_12);
    # Conv (onnx)
    conv2d_9 = Conv(silu_8, model.4.m.0.cv2.conv.weight, model.4.m.0.cv2.conv.bias, group=1, auto_pad="NOTSET", dilations=[1, 1], strides=[1, 1], pads=[1, 1, 1, 1]);
    # Sigmoid (onnx)
