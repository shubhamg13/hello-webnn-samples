    # Sigmoid (onnx)
    val_9 = Sigmoid(conv2d_6);
    # Mul (onnx)
    silu_6 = Mul(conv2d_6, val_9);
    # Conv (onnx)
    conv2d_7 = Conv(silu_6, model.4.cv1.conv.weight, model.4.cv1.conv.bias, group=1, auto_pad="NOTSET", dilations=[1, 1], strides=[1, 1], pads=[0, 0, 0, 0]);
    # Sigmoid (onnx)
