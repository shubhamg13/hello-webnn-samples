    # Mul (onnx)
    silu_9 = Mul(conv2d_9, val_13);
    # Add (onnx)
    add_1 = Add(split_with_sizes_4_split_1, silu_9);
    # Conv (onnx)
    conv2d_10 = Conv(add_1, model.4.m.1.cv1.conv.weight, model.4.m.1.cv1.conv.bias, group=1, auto_pad="NOTSET", dilations=[1, 1], strides=[1, 1], pads=[1, 1, 1, 1]);
    # Sigmoid (onnx)
