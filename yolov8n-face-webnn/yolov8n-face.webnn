    # Sigmoid (onnx)
    val_6 = Sigmoid(conv2d_4);
    # Mul (onnx)
    silu_4 = Mul(conv2d_4, val_6);
    # Add (onnx)
    add = Add(split_with_sizes_1_split_1, silu_4);
    # Concat (onnx)
    cat = Concat(split_with_sizes_1_split_0, split_with_sizes_1_split_1, add, axis=1);
    # Conv (onnx)
