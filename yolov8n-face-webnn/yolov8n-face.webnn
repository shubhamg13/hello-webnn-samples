  nodes {
    # Conv (onnx)
    conv2d = Conv(images, model.0.conv.weight, model.0.conv.bias, group=1, auto_pad="NOTSET", dilations=[1, 1], strides=[2, 2], pads=[1, 1, 1, 1]);
    # Sigmoid (onnx)
    val_0 = Sigmoid(conv2d);
    # Mul (onnx)
    silu = Mul(conv2d, val_0);
    # Conv (onnx)
    conv2d_1 = Conv(silu, model.1.conv.weight, model.1.conv.bias, group=1, auto_pad="NOTSET", dilations=[1, 1], strides=[2, 2], pads=[1, 1, 1, 1]);
    # Sigmoid (onnx)
